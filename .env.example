# ==============================================================================
# WasmBoost - VPS & Production Environment Configuration Template
# Copy this file to .env and configure for your domain or VPS IP
# ==============================================================================

# Domain or IP of your VPS
DOMAIN_NAME=your-server-ip-or-domain.com

# CORS Configuration (comma-separated list of allowed origins)
WASMBOOST_CORS_ORIGINS=http://localhost,http://localhost:3000,http://your-server-ip-or-domain.com,https://your-server-ip-or-domain.com
WASMBOOST_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Redis / Celery Configuration (defaults to internal Docker service name)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend API & WebSocket URLs
# When deploying behind the Nginx reverse proxy, '/api' is used by default.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=
